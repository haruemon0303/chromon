{
  "dialogues": {
    "professor_intro": {
      "text": [
        "カゲン村へようこそ！",
        "私はクロノス博士じゃ。",
        "古代遺跡と時間の謎を",
        "研究しておる。",
        "もう研究所には行ったかな？",
        "助手が最初の仲間を",
        "授けてくれるぞ！"
      ]
    },
    "rival_intro": {
      "text": [
        "やあ！ぼくも今日",
        "最初の仲間をもらうんだ！",
        "どっちが強いトレーナーに",
        "なれるか、勝負だね！"
      ]
    },
    "elder_intro": {
      "text": [
        "ようこそ、旅人よ。",
        "古の時代、人々は生物と",
        "調和して暮らしておった。",
        "大樹は過去と未来を繋ぐ。",
        "よく守るのじゃぞ。"
      ]
    },
    "assistant_starter": {
      "text": [
        "こんにちは！研究所へようこそ！",
        "最初のパートナーを",
        "選びますか？",
        "",
        "３体の中から選べます：",
        "メビー（草タイプ）",
        "ヒコ（炎タイプ）",
        "スイヒレ（水タイプ）",
        "",
        "どの子にしますか？"
      ],
      "choices": ["メビー", "ヒコ", "スイヒレ"],
      "giveCreature": true
    },
    "timeline_event": {
      "text": [
        "大樹に近づいた。",
        "根が古代の力で",
        "光り輝いている……",
        "",
        "世界が揺らめいている！",
        "",
        "時間そのものが動いている！",
        "",
        "別の時代へ",
        "渡ってしまった！"
      ],
      "triggersTimeline": true
    },
    "wild_encounter": {
      "text": [
        "野生の生物が現れた！"
      ]
    },
    "battle_won": {
      "text": [
        "勝利した！",
        "仲間が経験値を得た！"
      ]
    },
    "capture_success": {
      "text": [
        "やった！",
        "{creature}を捕獲した！"
      ]
    },
    "capture_fail": {
      "text": [
        "しまった！逃げられた！"
      ]
    },
    "ancient_choice": {
      "text": [
        "ここに大きな倒木がある。",
        "この先には古代の聖域が",
        "広がっているはずだが……",
        "",
        "この倒木をどうする？",
        "",
        "現代に影響が出るかもしれん。",
        "よく考えて選ぶのじゃ。"
      ],
      "choices": ["どける", "そのままにする"],
      "triggersChoice": true
    },
    "tree_removed": {
      "text": [
        "倒木をどけた！",
        "",
        "古代の力が流れ込み、",
        "時空に変化が生じた……",
        "",
        "未来の道が開かれたようだ。"
      ]
    },
    "tree_kept": {
      "text": [
        "倒木はそのままにした。",
        "",
        "自然の流れに任せよう。",
        "",
        "未来もこの状態を",
        "引き継ぐことになる。"
      ]
    },
    "intro_story": {
      "text": [
        "――時渡りの大樹が暴走した。",
        "",
        "目を開けると、そこは……",
        "見知らぬ古代の世界だった。",
        "",
        "この時代で出会う選択が、",
        "未来を変えるかもしれない。"
      ]
    }
  }
}
